
@{
    ViewBag.Title = "CreateCustomer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Create Customer</h2>

<form>
    <div class="form-group">
        <label for="name">Name</label>
        <div class="row">
            <div class="col-md-4">
                <input type="text" class="form-control" id="fname" placeholder="First Name">
            </div>
            <div class="col-md-4">
                <input type="text" class="form-control" id="mname" placeholder="Middle Name">
            </div>
            <div class="col-md-4">
                <input type="text" class="form-control" id="lname" placeholder="Last Name">
            </div>
        </div>
    </div>
    <div class="form-group">
        <label for="email">Email</label>
        <div class="row">
            <div class="col-md-8">
                <input type="email" class="form-control" id="email" placeholder="Email">
            </div>
        </div>
    </div>
    <div class="form-group">
        <label for="phone">Phone No.</label>
        <div class="row">
            <div class="col-md-4">
                <input type="number" class="form-control" id="phone" placeholder="Phone No.">
            </div>
        </div>
    </div>
    <div class="form-group">
        <label for="mobile">Mobile No.</label>
        <div class="row">
            <div class="col-md-4">
                <input type="number" class="form-control" id="mobile" placeholder="Mobile No.">
            </div>
        </div>
    </div>

    <div class="form-group">
        <label for="exampleFormControlFile1">Upload Profile Image</label>
        <input type="file" class="form-control-file" id="exampleFormControlFile1">
    </div>

    <div class="form-check">
        <input class="form-check-input" type="checkbox" value="" id="defaultCheck1">
        <label class="form-check-label" for="defaultCheck1">
            Is Staff ?
        </label>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
</form>
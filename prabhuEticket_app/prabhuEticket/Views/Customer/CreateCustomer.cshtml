@model prabhuEticket.Models.customer_register

@{
    ViewBag.Title = "CreateCustomer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Create Customer</h2>

@using (Html.BeginForm("create", "Customer", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="form-group">
        <label for="name">Name</label>
        <div class="row">
            <div class="col-md-4">
                @Html.TextBoxFor(model => model.first_name, new { placeholder = "First Name", @class = "form-control" })
            </div>
            <div class="col-md-4">
                @Html.TextBoxFor(model => model.middle_name, new { placeholder = "Middle Name", @class = "form-control" })
            </div>
            <div class="col-md-4">
                @Html.TextBoxFor(model => model.last_name, new { placeholder = "Last Name", @class = "form-control" })
            </div>
        </div>
    </div>
    <div class="form-group">
        <label for="email">Email</label>
        <div class="row">
            <div class="col-md-8">
                @Html.TextBoxFor(model => model.email_address, new { placeholder = "Email", @class = "form-control" })
            </div>
        </div>
    </div>
    <div class="form-group">
        <label for="phone">Phone No.</label>
        <div class="row">
            <div class="col-md-4">
                @Html.TextBoxFor(model => model.phone_no, new { placeholder = "Phone No.", @class = "form-control" })
            </div>
        </div>
    </div>
    <div class="form-group">
        <label for="mobile">Mobile No.</label>
        <div class="row">
            <div class="col-md-4">
                @Html.TextBoxFor(model => model.mobile_no, new { placeholder = "Mobile No.", @class = "form-control" })
            </div>
        </div>
    </div>

    <div class="form-group">
        <label for="exampleFormControlFile1">Upload Profile Image</label>
        <input type="file" class="form-control-file" name="imgfile">
    </div>

    <div class="form-check">

        <label class="form-check-label" for="defaultCheck1">


            Is Staff ?

        </label>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
}


@model prabhuEticket.Models.internal_CustomerProfile_edit_request

@{
    ViewBag.Title = "Update Customer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Create Customer</h2>

@using (Html.BeginForm("UpdateCustomer", "Customer", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="form-group">
        @Html.HiddenFor(model => model.customer_id)
        <div class="row">
            <div class="col-md-4">
                @Html.LabelFor(model => model.first_name, labelText: "First Name")
                @Html.TextBoxFor(model => model.first_name, new { placeholder = "First Name", @class = "form-control" })
                @Html.ValidationMessageFor(model => model.first_name, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(model => model.middle_name, labelText: "Middle Name")
                @Html.TextBoxFor(model => model.middle_name, new { placeholder = "Middle Name", @class = "form-control" })
                @Html.ValidationMessageFor(model => model.middle_name, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(model => model.last_name, labelText: "Last Name")
                @Html.TextBoxFor(model => model.last_name, new { placeholder = "Last Name", @class = "form-control" })
                @Html.ValidationMessageFor(model => model.last_name, "", new { @class = "text-danger" })
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-md-4">
                @Html.LabelFor(model => model.email_address, labelText: "Email Address")
                @Html.TextBoxFor(model => model.email_address, new { placeholder = "Email", @class = "form-control" })
                @Html.ValidationMessageFor(model => model.email_address, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(model => model.mobile_no, labelText: "Mobile Number")
                @Html.TextBoxFor(model => model.mobile_no, new { placeholder = "Mobile No", @class = "form-control" })
                @Html.ValidationMessageFor(model => model.mobile_no, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-4">
                @Html.LabelFor(model => model.phone_no, labelText: "Phone Number")
                @Html.TextBoxFor(model => model.phone_no, new { placeholder = "Phone No", @class = "form-control" })
                @Html.ValidationMessageFor(model => model.mobile_no, "", new { @class = "text-danger" })
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-md-4">
                @Html.LabelFor(model => model.customer_type, labelText: "Customer Type")
                @Html.DropDownListFor(model => model.customer_type,
               new List<SelectListItem>{ new SelectListItem {Selected=true,Text="--Select--",Value="" },
               new SelectListItem {Selected=false,Text="Normal",Value="Normal" },
               new SelectListItem {Selected=false,Text="Student",Value="Student" },
               new SelectListItem {Selected=false,Text="Elderly",Value="Elderly" },
               new SelectListItem {Selected=false,Text="Handicapped",Value="Handicapped" }},
               new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.customer_type, "", new { @class = "text-danger" })
            </div>
            @*<div class="col-md-4">
                    @Html.LabelFor(model => model.credit_limit, labelText: "Credit Limit")
                    @Html.TextBoxFor(model => model.phone_no, new { placeholder = "Phone No", @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.mobile_no, "", new { @class = "text-danger" })
                </div>*@
        </div>
    </div>
    <div class="form-group">

        @Html.TextBoxFor(model => model.pic_path, new { @class = "btn btn-sm", @text = "Choose File", @type = "file" })
        @Html.ValidationMessageFor(model => model.pic_path, "", new { @class = "text-danger" })
    </div>
    <button type="submit" class="btn btn-primary">Update</button>
}


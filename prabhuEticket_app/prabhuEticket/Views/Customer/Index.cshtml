
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model prabhuEticket.Models.CustomerProfile_request
<h2>Index</h2>

<div class="row">
    <div id="progress" class="modal">
        <div class="center">
            <img src="~/images/loader4.gif" />
        </div>
    </div>
    <!-- Earnings (Monthly) Card Example -->
    <div class="col-xl-12 col-md-12 mb-12">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">

                @*@if (ViewBag.validationSummary != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong>Woah!</strong> @ViewBag.validationSummary.
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    }*@
                <div class="input-group" id="cardNum_div">
                    @Html.EditorFor(model => model.card_number, new { htmlAttributes = new { @class = "form-control form-control-user", @type = "text", @placeholder = "Please enter Card Number.." } })
                    @Html.ValidationMessageFor(model => model.card_number, "", new { @class = "text-danger" })
                    <div class="input-group-append">
                        <button class="btn btn-primary" onclick="submit()" type="button">
                            <i class="fas fa-search fa-sm"></i>
                        </button>
                    </div>
                </div>
                <span class="field-validation-valid text-danger" data-valmsg-for="cardNum_div" data-valmsg-replace="true">

                </span>
            </div>
        </div>
    </div>
</div>
<div id="example" class="card-body" hidden="hidden">


    <table id="" class="table table-striped table-bordered" style="width:100%">
        <thead>
            <tr>
                <th>Card Number</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Mobile</th>
                <th>Is Staff</th>
                <th>Created At</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td id="card_no"></td>
                <td id="full_name"></td>
                <td id="email"></td>
                <td id="mobile"></td>
                <td id="isStaff"></td>
                <td id="created_at"></td>
                <td id="action">
                    <div class="dropdown">

                        <i class="fas fa-bars dropdown-toggle text-black" data-toggle="dropdown"></i>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" id="view" href="#"><i class="fas fa-eye"></i>&nbsp;View</a>
                            <a class="dropdown-item" id="edit" href="#"><i class="fas fa-pen"></i>&nbsp;Edit</a>
                            <a class="dropdown-item" id="delete" href="#"><i class="fas fa-trash"></i>&nbsp;Delete</a>
                        </div>
                    </div>
                </td>
            </tr>
        </tbody>
        <tfoot>
            <tr>
                <th>Card Number</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Mobile</th>
                <th>Is Staff</th>
                <th>Created At</th>
                <th>Action</th>
            </tr>
        </tfoot>
    </table>
</div>

@section scripts{
    @*$(document).ready(function() {*@
    @*$('#example').DataTable();
        });*@
    function submit()
    {
    var cardNum=$('#card_number').val();
    if(cardNum.trim()==undefined||cardNum.trim()=="")
    {
    $("span[data-valmsg-for='cardNum_div']").html("Card Number is required");
    return ;
    }
    var request = $.ajax({
    url: "/customer/index",
    method: "POST",
    data: { card_number : cardNum },
    dataType: "JSON"
    });

    request.done(function( msg ) {
    @*$( "#progress" ).html( msg );
        console.log(msg);*@
    if(msg.status==false||msg.status_code!=200)
    {
    $("span[data-valmsg-for='cardNum_div']").html(msg.error_Lists[0].error_message);
    $('#example').attr("hidden","hidden")
    }
    else
    {
    $("span[data-valmsg-for='cardNum_div']").html("");
    $('#example').removeAttr('hidden');
    $('#card_no').html(msg.data[0].card_detail.card_number);
    $('#full_name').html(msg.data[0].fullName);
    $('#email').html(msg.data[0].email);
    $('#mobile').html(msg.data[0].mobile);
    $('#isStaff').html(msg.data[0].isSatff);
    $('#created_at').html(msg.data[0].create_ts);
    $('#edit').attr('href','/Customer/UpdateCustomer/'+msg.data[0].id )
    //$('#action').html('');
    }
    });

    request.fail(function( jqXHR, textStatus ) {
    alert( "Request failed: " + textStatus );
    });
    }
}

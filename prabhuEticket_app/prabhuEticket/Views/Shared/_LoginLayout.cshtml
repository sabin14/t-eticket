<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>@ViewBag.Title</title>
    @*derived from BundleConfig.cs*@
    @Styles.Render("~/fonts")
    @Styles.Render("~/css")
    <style>
        #buttons span:before {
            content: "\f139";
            color: red;
            margin-left: 60%;
        }

        #buttons.collapsed span:before {
            content: "\f13a";
            color: red;
        }

        #collapse2 {
            width: 80%;
            box-sizing: border-box;
            border-radius: .35rem;
            margin-left: 30px;
            background-color: lightgray;
        }

        .collapse-item2 {
            padding: .5rem 1rem;
            display: block;
            color: #3a3b45;
            text-decoration: none;
            border-radius: .35rem;
            white-space: nowrap;
            box-sizing: border-box;
        }

            .collapse-item2:hover {
                background-color: #eaecf4;
                color: black;
                text-decoration: none;
                box-sizing: border-box;
            }
    </style>
</head>
<body class="bg-gradient-primary">
    <div class="container">
        @RenderBody()
    </div>
    @Scripts.Render("~/js/bootstrap")
    @Scripts.Render("~/js/core")
    @Scripts.Render("~/js/custom")
</body>
</html>

</body>